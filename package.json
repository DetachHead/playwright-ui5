{
  "name": "playwright-ui5",
  "version": "1.6.9",
  "keywords": [],
  "license": "ISC",
  "author": "detachhead",
  "repository": {
    "type": "git",
    "url": "https://github.com/DetachHead/playwright-ui5.git"
  },
  "files": [
    "dist",
    "src/node"
  ],
  "main": "dist/node/main.js",
  "scripts": {
    "test": "tsc -p tests/tsconfig.json && playwright test",
    "lint:check": "oxlint .",
    "lint:fix": "./pnpm.cmd run lint:check -- --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "build:browser": "tsc -p src/browser/tsconfig.json && node build.ts",
    "build:node": "tsc -p src/node/tsconfig.json",
    "typecheck:config-files": "tsc",
    "build": "rimraf ./dist && ./pnpm.cmd run build:browser && ./pnpm.cmd run build:node",
    "check": "./pnpm.cmd run typecheck:config-files && ./pnpm.cmd run build && ./pnpm.cmd run test && ./pnpm.cmd run lint:check && ./pnpm.cmd run format:check",
    "setup": "./pnpm.cmd install && playwright install-deps && playwright install"
  },
  "dependencies": {
    "css-selector-parser": "^2",
    "fontoxpath": "^3.30.3",
    "lodash": "^4.17.21",
    "playwright-core": "^1.43.0",
    "throw-expression": "^1.0.2",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": ">=4.8.1",
    "@playwright/test": "1.64.1",
    "@sapui5/ts-types-esm": "^1.123.1",
    "@stylistic/eslint-plugin": ">=5.10.0",
    "@types/is-ci": "^3.0.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.6",
    "@types/three": "^0.150.2",
    "esbuild": "^0.15.5",
    "eslint": ">=10.14.0",
    "eslint-plugin-prefer-arrow-functions": ">=3.10.2",
    "is-ci": "^3.0.1",
    "oxfmt": ">=0.76.0",
    "oxlint": ">=1.91.0",
    "oxlint-tsgolint": ">=7.0.2005",
    "rimraf": "^3.0.2",
    "typescript": ">=7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.3.1",
      "onFail": "download"
    }
  }
}
