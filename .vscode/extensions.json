{
  "recommendations": [
    "oxc.oxc-vscode",
    "ms-playwright.playwright",
    "github.vscode-github-actions",
    "detachhead.vsenv", // https://github.com/microsoft/playwright/issues/43033
    "maximsmol.vscode-lsp-generic"
  ],
  "unwantedRecommendations": [
    // see comment in .vscode/settings.json where we configure the generic lsp instead.
